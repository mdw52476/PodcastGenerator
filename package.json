{
  "name": "shoebox-studio",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "render": "tsx packages/engine/scripts/render.ts",
    "align": "tsx packages/engine/scripts/align.ts",
    "preview": "pnpm --filter @shoebox/engine studio",
    "test": "vitest run",
    "typecheck": "tsc -p packages/edit-plan && tsc -p packages/text-rules && tsc -p packages/engine && tsc -p apps/worker && tsc -p apps/web",
    "check-text": "tsx packages/text-rules/src/cli.ts",
    "job": "tsx apps/worker/src/cli.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "dropbox-auth": "tsx apps/worker/src/dropbox-auth.ts",
    "web": "pnpm --filter @shoebox/web dev",
    "web:build": "pnpm --filter @shoebox/web build",
    "owner:add": "tsx apps/worker/src/owner.ts",
    "shows:seed": "tsx apps/worker/src/seed-shows.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
